{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "body"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "disabled": true,
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "share": {
          "type": "share",
          "disabled": true,
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "title",
        "vendor",
        "variant_picker",
        "quantity_selector",
        "price",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "stacked",
        "media_position": "left",
        "image_zoom": "none",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 64,
        "padding_bottom": 0
      }
    },
    "product_benefits": {
      "type": "multicolumn",
      "blocks": {
        "benefit_1": {
          "type": "column",
          "settings": {
            "title": "Who it's for",
            "text": "<p>Use this column to describe the hair type, concerns, and goals this product is designed to address.<\/p>",
            "link_label": "",
            "link": ""
          }
        },
        "benefit_2": {
          "type": "column",
          "settings": {
            "title": "Key benefits",
            "text": "<p>Call out 3\u20135 headline benefits like moisture, volume, definition, or repair. Keep them short and scannable.<\/p>",
            "link_label": "",
            "link": ""
          }
        },
        "benefit_3": {
          "type": "column",
          "settings": {
            "title": "How to use",
            "text": "<p>Share your ideal usage instructions\u2014how much to apply, how often, and any pro stylist tips.<\/p>",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
        "benefit_1",
        "benefit_2",
        "benefit_3"
      ],
      "settings": {
        "title": "<strong>Why you'll love it<\/strong>",
        "heading_size": "h2",
        "image_width": "full",
        "image_ratio": "adapt",
        "columns_desktop": 3,
        "column_alignment": "top",
        "background_style": "none",
        "swipe_on_mobile": true,
        "color_scheme": "background-1",
        "padding_top": 40,
        "padding_bottom": 24
      }
    },
    "product_faq": {
      "type": "collapsible-content",
      "blocks": {
        "faq_shipping": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Shipping & returns",
            "icon": "truck",
            "content": "<p>Add details about shipping speeds, order cut-off times, and how returns or exchanges work for haircare products.<\/p>"
          }
        },
        "faq_ingredients": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Ingredients & sensitivities",
            "icon": "question_mark",
            "content": "<p>Link to ingredient lists, allergen info, and guidance for sensitive scalps.<\/p>"
          }
        },
        "faq_results": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Results & routine fit",
            "icon": "star",
            "content": "<p>Set expectations for when customers may see results and how this product fits into a broader routine.<\/p>"
          }
        }
      },
      "block_order": [
        "faq_shipping",
        "faq_ingredients",
        "faq_results"
      ],
      "settings": {
        "heading": "Questions customers often ask",
        "heading_size": "h2",
        "icon": "plus",
        "color_scheme": "background-1",
        "container_color_scheme": "background-1",
        "open_first_collapsible_row": false,
        "padding_top": 32,
        "padding_bottom": 32
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You might also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "background-1",
        "image_ratio": "portrait",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 48,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "product_benefits",
    "product_faq",
    "related-products"
  ]
}
