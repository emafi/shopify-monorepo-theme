{% schema %}
  {
    "name": "Custom block",
    "tag": "section",
    "class": "section custom-block",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Custom block title"
      }, {
        "type": "image_picker",
        "id": "image",
        "label": "Primary image"
      }, {
        "type": "image_picker",
        "id": "secondary_image",
        "label": "Secondary image"
      }, {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "default": "#ffffff"
      }
    ],
    "presets": [
      {
        "name": "Custom block",
        "category": "Custom"
      }
    ]
  }
{% endschema %}

<section class="custom-block-section" style="background-color: {{ section.settings.background_color }};">
  <div class="page-width custom-block__inner">
    {% if section.settings.title != blank %}
      <h2 class="custom-block__title">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    <div class="custom-block__images">
      {% if section.settings.image != blank %}
        <div class="custom-block__image custom-block__image--primary">
          {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.title }}
        </div>
      {% endif %}

      {% if section.settings.secondary_image != blank %}
        <div class="custom-block__image custom-block__image--secondary">
          {{ section.settings.secondary_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.title }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .custom-block-section {
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
  }

  .custom-block-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 20% 50%, rgba(var(--color-base-accent-1), 0.03) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(var(--color-base-accent-2), 0.03) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
  }

  .custom-block__inner {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    position: relative;
    z-index: 1;
  }

  .custom-block__title {
    margin: 0 0 1rem 0;
    text-align: center;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-size: calc(var(--font-heading-scale) * 3.5rem);
    line-height: 1.2;
    background: linear-gradient(135deg, rgba(var(--color-foreground), 1) 0%, rgba(var(--color-foreground), 0.7) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media screen and (min-width: 750px) {
    .custom-block__title {
      font-size: calc(var(--font-heading-scale) * 4.5rem);
    }
  }

  .custom-block__images {
    display: flex;
    flex-wrap: wrap;
    gap: 2.4rem;
    justify-content: center;
    align-items: center;
  }

  .custom-block__image {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    flex: 0 1 auto;
    max-width: 100%;
  }

  .custom-block__image::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.1) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 1;
    pointer-events: none;
  }

  .custom-block__image:hover::before {
    opacity: 1;
  }

  .custom-block__image:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
  }

  .custom-block__image img {
    display: block;
    max-width: 100%;
    height: auto;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    filter: brightness(1);
  }

  .custom-block__image:hover img {
    transform: scale(1.05);
    filter: brightness(1.03);
  }

  .custom-block__image--primary {
    flex: 0 1 45%;
    min-width: 280px;
  }

  .custom-block__image--secondary {
    flex: 0 1 45%;
    min-width: 280px;
  }

  @media screen and (max-width: 749px) {
    .custom-block-section {
      padding: 4rem 0;
    }

    .custom-block__inner {
      gap: 3rem;
    }

    .custom-block__images {
      flex-direction: column;
      gap: 2rem;
    }

    .custom-block__image--primary,
    .custom-block__image--secondary {
      flex: 1 1 100%;
      max-width: 100%;
    }
  }
{% endstylesheet %}