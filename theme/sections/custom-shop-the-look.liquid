{% comment %}
  Sezione: custom-shop-the-look

  Scopo:
  - Mostrare un'immagine editoriale con hotspot cliccabili ("shop the look")
  - Ogni hotspot è collegato a un prodotto Shopify e ne mostra anche la card nella colonna prodotti

  Parametri principali (section.settings):
  - image: immagine principale del look
  - heading: titolo della sezione
  - text: testo descrittivo / copy marketing
  - heading_size: dimensione del titolo (h1/h2/h3)
  - color_scheme: schema colore per sfondo e testo

  Parametri principali (block.settings per tipo "hotspot"):
  - product: prodotto associato all'hotspot
  - accessible_label: etichetta per screen reader (fallback al titolo prodotto)
  - horizontal_position: posizione orizzontale del bottone (0–100%)
  - vertical_position: posizione verticale del bottone (0–100%)

  Dipendenze:
  - Usa lo snippet 'card-product' del tema per rendere la lista prodotti
  - Non richiede librerie JS esterne; il comportamento è puramente link-based
{% endcomment %}

<style>
  .shop-the-look {
    position: relative;
  }

  .shop-the-look__inner {
    display: grid;
    gap: 3.2rem;
  }

  @media screen and (min-width: 750px) {
    .shop-the-look__inner {
      grid-template-columns: minmax(0, 3fr);
    }
  }

  .shop-the-look__media-wrapper {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
  }

  .shop-the-look__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .shop-the-look__hotspot {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 2px solid rgb(var(--color-background));
    background: rgba(var(--color-button), 0.9);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.16);
    transition: transform 0.18s ease-out
    , box-shadow 0.18s ease-out
    , background 0.18s ease-out;
  }

  .shop-the-look__hotspot::before {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: inherit;
    border: 1px solid rgba(var(--color-background), 0.35);
    opacity: 0.7;
  }

  .shop-the-look__hotspot-icon {
    color: rgb(var(--color-base-solid-button-labels));
    font-size: 1.6rem;
    line-height: 1;
  }

  .shop-the-look__hotspot:hover {
    transform: translate(-50%, -50%) scale(1.06);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
    background: rgba(var(--color-button), 1);
  }

  .shop-the-look__hotspot:focus-visible {
    outline: 2px solid rgba(var(--color-base-accent-1), 0.8);
    outline-offset: 2px;
  }

  .shop-the-look__hotspot.is-out-of-stock {
    background: rgba(var(--color-foreground), 0.4);
  }

  .shop-the-look__products {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 2.4rem;
  }

  @media screen and (min-width: 990px) {
    .shop-the-look__inner {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: flex-start;
    }

    .shop-the-look__products {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
  }
</style>

{%- liquid
  assign section_has_products = false

  for block in section.blocks
    if block.type == 'hotspot' and block.settings.product != blank
      assign section_has_products = true
      break
    endif
  endfor
-%}

<div class="shop-the-look color-{{ section.settings.color_scheme }} gradient">
  <div class="shop-the-look__inner page-width">
    <div class="shop-the-look__media-wrapper">
      {%- if section.settings.image != blank -%}
        {%- capture sizes -%}
          (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 120 }}px,
          (min-width: 750px) calc(100vw - 96px),
          calc(100vw - 48px)
        {%- endcapture -%}
        {{
          section.settings.image | image_url: width: 1800 | image_tag: widths: '360, 533, 720, 940, 1440, 1800', sizes: sizes, class: 'shop-the-look__image', alt: section.settings.heading | default: section.settings.image.alt | escape
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg shop-the-look__image' }}
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'hotspot' and block.settings.product != blank -%}
          {%- assign product = block.settings.product -%}
          {%- assign left = block.settings.horizontal_position | default: 50 -%}
          {%- assign top = block.settings.vertical_position | default: 50 -%}
          {%- assign is_out_of_stock = false -%}
          {%- if product.selected_or_first_available_variant.available == false -%}
            {%- assign is_out_of_stock = true -%}
          {%- endif -%}

          <a
            {{ block.shopify_attributes }}
            class="shop-the-look__hotspot{% if is_out_of_stock %} is-out-of-stock{% endif %}"
            href="{{ product.url }}"
            style="left: {{ left }}%; top: {{ top }}%;"
            aria-label="{{ block.settings.accessible_label | default: product.title | escape }}">
            <span class="shop-the-look__hotspot-icon">+</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section_has_products -%}
      <div class="shop-the-look__products">
        {%- if section.settings.heading != blank or section.settings.text != blank -%}
          <div class="shop-the-look__copy content-container">
            {%- if section.settings.heading != blank -%}
              <h2 class="{{ section.settings.heading_size }}">
                {{ section.settings.heading | escape }}
              </h2>
            {%- endif -%}
            {%- if section.settings.text != blank -%}
              <div class="rte">
                {{ section.settings.text }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'hotspot' and block.settings.product != blank -%}
            <div {{ block.shopify_attributes }}>
              {%- render 'card-product'
                , card_product: block.settings.product
                , media_aspect_ratio: 'portrait'
                , show_secondary_image: true
                , show_vendor: false
                , show_rating: false
                , show_quick_add: true
              -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
  {
    "name": "Custom - Shop the look",
    "tag": "section",
    "class": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Immagine del look"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Titolo",
        "default": "Shop the look"
      },
      {
        "type": "richtext",
        "id": "text",
        "label": "Testo",
        "default": "<p>Abbina un'immagine editoriale a prodotti acquistabili. Usa gli slider di posizione per allineare i pulsanti all'immagine.<\\/p>"
      },
      {
        "type": "select",
        "id": "heading_size",
        "label": "Heading size",
        "default": "h2",
        "options": [
          {
            "value": "h3",
            "label": "H3"
          }, {
            "value": "h2",
            "label": "H2"
          }, {
            "value": "h1",
            "label": "H1"
          }
        ]
      }, {
        "type": "select",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "background-1",
        "options": [
          {
            "value": "background-1",
            "label": "Background 1"
          },
          {
            "value": "background-2",
            "label": "Background 2"
          },
          {
            "value": "accent-1",
            "label": "Accent 1"
          },
          {
            "value": "accent-2",
            "label": "Accent 2"
          }, {
            "value": "inverse",
            "label": "Inverse"
          }
        ]
      }
    ],
    "blocks": [
      {
        "type": "hotspot",
        "name": "Product hotspot",
        "settings": [
          {
            "type": "product",
            "id": "product",
            "label": "Prodotto"
          }, {
            "type": "text",
            "id": "accessible_label",
            "label": "Etichetta accessibile",
            "info": "Opzionale. Usata dai lettori di schermo; se vuota usa il titolo del prodotto."
          }, {
            "type": "range",
            "id": "horizontal_position",
            "label": "Posizione orizzontale",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%",
            "default": 50
          }, {
            "type": "range",
            "id": "vertical_position",
            "label": "Posizione verticale",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%",
            "default": 50
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Custom - Shop the look",
        "blocks": [
          {
            "type": "hotspot"
          }, {
            "type": "hotspot"
          }, {
            "type": "hotspot"
          }
        ]
      }
    ]
  }
{% endschema %}

